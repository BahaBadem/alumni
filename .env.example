# ==============================================================================
# ALUMNI PORTAL - ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# ==============================================================================

# Django Ayarları
DEBUG=1
SECRET_KEY=django-insecure-alumni-portal-secret-key-change-in-production

# Veritabanı Seçimi: 'postgresql' veya 'sqlite'
DB_ENGINE=django.db.backends.postgresql
DB_NAME=alumni_db
DB_USER=alumni_user
DB_PASSWORD=alumni_password
DB_HOST=db
DB_PORT=5432

# PostgreSQL Konteyner Ayarları
POSTGRES_DB=alumni_db
POSTGRES_USER=alumni_user
POSTGRES_PASSWORD=alumni_password
