# ==============================================================================
# ALUMNI PORTAL - ENVIRONMENT VARIABLES TEMPLATE (.example.env)
# ==============================================================================
# Bu dosya bir örnektir. Gerçek geliştirme veya canlı ortam için:
# 1. Bu dosyayı '.env' adıyla kopyalayın: `cp .example.env .env`
# 2. Aşağıdaki değişkenleri kendi ortamınıza ve güvenli parolalarınıza göre doldurun.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO UYGULAMA AYARLARI
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# 2. VERİTABANI BAĞLANTI AYARLARI
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=alumni_db
DB_USER=alumni_user
DB_PASSWORD=your_strong_db_password_here
DB_HOST=db
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. DOCKER POSTGRESQL KONTEYNER AYARLARI
# ------------------------------------------------------------------------------
POSTGRES_DB=alumni_db
POSTGRES_USER=alumni_user
POSTGRES_PASSWORD=your_strong_db_password_here
